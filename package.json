{
  "name": "cocopay",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios --device Cocopay",
    "start": "expo start --ios --device Cocopay",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "build:ios": "mkdir -p build && eas build --platform ios --local --output \"build/cocopay-ios-$(node -p \"require('./app.json').expo.version\")-$(date +%Y%m%d-%H%M%S).ipa\"",
    "build:android": "mkdir -p build && eas build --platform android --local --output \"build/cocopay-android-$(node -p \"require('./app.json').expo.version\")-$(date +%Y%m%d-%H%M%S).apk\"",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "@account-kit/core": "^4.81.2",
    "@account-kit/infra": "^4.81.2",
    "@account-kit/smart-contracts": "^4.81.2",
    "@craftzdog/react-native-buffer": "^6.1.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@getpara/react-native-wallet": "^2.2.0",
    "@getpara/viem-v2-integration": "^2.2.0",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/native": "^7.1.6",
    "@rn-primitives/avatar": "^1.2.0",
    "@rn-primitives/checkbox": "^1.2.0",
    "@rn-primitives/dialog": "^1.2.0",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/progress": "^1.2.0",
    "@rn-primitives/radio-group": "^1.2.0",
    "@rn-primitives/select": "^1.2.0",
    "@rn-primitives/separator": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@rn-primitives/toggle": "^1.2.0",
    "@tanstack/query-async-storage-persister": "^5.90.14",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-persist-client": "^5.90.14",
    "alchemy-sdk": "^3.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^54.0.0",
    "expo-build-properties": "^1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "^8.0.8",
