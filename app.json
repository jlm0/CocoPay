{
  "expo": {
    "name": "CocoPay",
    "slug": "cocopay",
    "version": "1.0.0",
    "scheme": "cocopay",
    "platforms": ["ios", "android"],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/coconut.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CocoPay uses the camera to scan QR codes for payments"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CocoPay needs access to your photos to set a store logo."
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "REDACTED_GOOGLE_API_KEY"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/coconut.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/coconut.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cocopay.app",
      "associatedDomains": ["applinks:cocopay.app"],
      "config": {
        "googleMapsApiKey": "REDACTED_GOOGLE_API_KEY"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "CocoPay uses the camera to scan QR codes for payments",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cocopay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/coconut.png",
        "backgroundColor": "#ffffff"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REDACTED_GOOGLE_API_KEY"
        }
      },
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cocopay.app",
              "pathPrefix": "/pay"
            },
            {
              "scheme": "cocopay"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "96ddae85-e922-4d2f-955e-25b397d95960"
      }
    }
  }
}
